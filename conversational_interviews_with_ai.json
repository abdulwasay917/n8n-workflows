    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "={{ $json.answer }}",
        "options": {
          "systemMessage": "=You are a senior User Research Interviewer conducting an in-depth interview on: \"{{ $('Set Interview Topic').first().json.interview_topic }}\".\n\nINTERVIEW RULES:\n1. ASK A NEW QUESTION: Do NOT repeat, paraphrase, exaggerate, or echo the candidate's answer back to them. Ask a FRESH, NEW open-ended question.\n2. ONE QUESTION AT A TIME: Ask exactly ONE concise question per turn.\n3. PROGRESSIVE TOPICS: Explore different aspects of the interview topic (e.g. preparation, instructor feedback, test-day nerves, maneuvers, or test outcome).\n4. STOPPING: If the user says \"stop\", \"quit\", \"finish\", or if this is the final question, set stop_interview to true and question to \"\".\n\nOUTPUT FORMAT:\nYou MUST return ONLY a JSON object with two fields:\n- stop_interview: boolean\n- question: string\n\nOutput ONLY the raw JSON object string. Do not wrap in markdown or prefix with extraneous text."
        }
      },
      "id": "e579d7fb-2f44-429f-9ae4-de9869804bb2",
      "name": "AI Researcher",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        8016,
        1360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Robust parser & automatic interview loop controller (Safe $items access)\nconst rawOutput = $input.first().json.output;\n\nlet parsed = { stop_interview: false, question: \"Could you tell us more about your experience?\" };\n\nif (typeof rawOutput === 'object' && rawOutput !== null) {\n  parsed = rawOutput;\n} else if (typeof rawOutput === 'string') {\n  try {\n    const jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      parsed = JSON.parse(jsonMatch[0]);\n    } else {\n      parsed = JSON.parse(rawOutput);\n    }\n  } catch (e) {\n    const textLower = rawOutput.toLowerCase();\n    const isStop = textLower.includes(\"stop\") || textLower.includes(\"finish\") || textLower.includes(\"done\") || textLower.includes(\"thank you\");\n    parsed = {\n      stop_interview: isStop,\n      question: isStop ? \"\" : rawOutput.trim()\n    };\n  }\n}\n\n// Safely count turns without throwing \"Node hasn't been executed\" on Turn 1\nlet previousQuestionsCount = 0;\ntry {\n  previousQuestionsCount = $items(\"Generate Row\").length;\n} catch (e) {\n  previousQuestionsCount = 0;\n}\n\nconst isMaxQuestions = previousQuestionsCount >= 4; // Max 5 questions total\n\n// Check explicit user stop keywords\nlet userText = \"\";\ntry {\n  userText = String($('Get Answer').first()?.json?.answer || \"\").toLowerCase();\n} catch (e) {}\n\nconst userWantsStop = userText.includes(\"stop\") || userText.includes(\"quit\") || userText.includes(\"exit\") || userText.includes(\"finish\") || userText.includes(\"done\");\n\nconst stop_interview = Boolean(isMaxQuestions || userWantsStop || parsed.stop_interview);\nconst question = stop_interview ? \"\" : (parsed.question || \"Could you share another aspect of your experience?\");\n\nreturn [{\n  json: {\n    output: {\n      stop_interview,\n      question\n    }\n  }\n}];"
      },
