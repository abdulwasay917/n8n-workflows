    {
      "parameters": {
        "jsCode": "// Safely construct row objects for Google Sheets without string parsing errors\nconst sessionIdData = $('UUID').first()?.json?.data || 'unknown_session';\nconst session_id = `session_${sessionIdData}`;\nconst name = $('Start Interview').first()?.json['What is your name?'] || 'Anonymous';\n\nreturn $input.all().map(item => {\n  const s = item.json.session || item.json || {};\n  return {\n    json: {\n      session_id,\n      name,\n      timestamp: s.timestamp || new Date().toISOString(),\n      type: s.type || 'next_question',\n      question: s.question || '',\n      answer: s.answer || ''\n    }\n  };\n});"
      },
      "id": "794ce315-76b0-4a58-a87b-2df5790ab3c4",
      "name": "Messages To JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        9968,
        1200
      ]
    },
    {
      "parameters": {
        "jsCode": "const safeGetItems = (nodeName) => {\n  try {\n    return $items(nodeName).map(i => i.json);\n  } catch (e) {\n    return [];\n  }\n};\n\nconst startRow = safeGetItems(\"Generate Row2\");\nconst answerRows = safeGetItems(\"Generate Row\");\nconst endRow = safeGetItems(\"Generate Row1\");\n\nconst session = [...startRow, ...answerRows, ...endRow];\n\nreturn [{\n  json: {\n    session\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
