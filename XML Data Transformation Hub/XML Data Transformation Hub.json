    },
    {
      "parameters": {
        "jsCode": "let results = [];\n\nfor (let item of $input.all()) {\n  try {\n    let body = item.json.body || item.json;\n    let xmlData = body.xml || (typeof body === 'string' ? body : Object.values(body)[0]);\n\n    if (!xmlData || typeof xmlData !== 'string' || xmlData.trim() === '') {\n      results.push({\n        json: {\n          valid: false,\n          error: 'The submitted XML data is empty or missing.',\n          statusCode: 400\n        }\n      });\n      continue;\n    }\n\n    let trimmed = xmlData.trim();\n    if (!trimmed.includes('<') || !trimmed.includes('>')) {\n      results.push({\n        json: {\n          valid: false,\n          error: 'The provided content is not formatted as valid XML syntax.',\n          statusCode: 400\n        }\n      });\n      continue;\n    }\n\n    results.push({\n      json: {\n        valid: true,\n        xml: trimmed\n      }\n    });\n  } catch (error) {\n    results.push({\n      json: {\n        valid: false,\n        error: 'Error processing input: ' + error.message,\n        statusCode: 400\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "name": "Extract & Validate XML Input",
