    {
      "parameters": {
        "jsCode": "let items = $input.all();\nif (items.length === 0) return [];\n\n// Random selection logic: ~35% probability per surprise subscriber\nlet selected = items.filter(() => Math.random() < 0.35);\n\n// Guarantee at least 1 surprise user is selected if list is non-empty\nif (selected.length === 0 && items.length > 0) {\n  let randomIndex = Math.floor(Math.random() * items.length);\n  selected.push(items[randomIndex]);\n}\n\nreturn selected;"
      },
      "name": "Random Subset Selector",
      "type": "n8n-nodes-base.code",
      "position": [
